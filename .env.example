# Database
DATABASE_URL=postgresql://epiro:epiro_password@postgres:5432/epiro
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Used only by the test suite, which creates and drops its own schema.
# Never point this at a database holding real data.
TEST_DATABASE_URL=postgresql://epiro:epiro_password@localhost:5432/epiro_test

# Redis
REDIS_URL=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
SECRET_KEY=your-super-secret-key-change-in-production

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=EPIRO
NEXT_PUBLIC_VERSION=1.0.0

# AI/LLM
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4-turbo

# Storage
STORAGE_TYPE=local
STORAGE_PATH=/data
AWS_S3_BUCKET=
AWS_REGION=

# Email
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=noreply@epiro.local

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Environment
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Organization
ORG_NAME=EPIRO
ORG_COUNTRY=NG
ORG_TIMEZONE=Africa/Lagos

# Security
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7
MFA_ENABLED=false

# Rate limiting. The in-process default counts per worker, so a deployment
# running more than one worker should point the storage at Redis.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_PUBLIC_WRITE_PER_MINUTE=10

# Features
FEATURE_AI_ASSISTANT=true
FEATURE_RAG=true
FEATURE_OFFLINE_MODE=true
FEATURE_MULTILINGUAL=true
